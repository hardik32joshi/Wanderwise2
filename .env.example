# Supabase (get these from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard -> Settings -> Webhooks when you add the webhook URL
RAZORPAY_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys) — for booking confirmation / password reset emails
RESEND_API_KEY=

# Mapbox (https://account.mapbox.com/access-tokens) — for destination/hotel maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenWeather (https://openweathermap.org/api) — for the destination weather widget
OPENWEATHER_API_KEY=

# Anthropic (https://console.anthropic.com) — for the AI trip-planning assistant
AI_API_KEY=
